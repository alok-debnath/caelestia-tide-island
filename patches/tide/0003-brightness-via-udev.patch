+// Watch the backlight subsystem for udev change events. Reuses the udev
+// context created for power_supply monitoring, creating one if battery setup
+// never got that far.
+void SysBackend::setupBacklightMonitor() {
+    if (!m_udev) {
+        m_udev = udev_new();
+        if (!m_udev) {
+            qWarning() << "[SysBackend] Failed to create udev context for backlight monitoring";
+            return;
+        }
+    }
+
+    m_backlightMonitor = udev_monitor_new_from_netlink(m_udev, "udev");
+    if (!m_backlightMonitor) {
+        qWarning() << "[SysBackend] Failed to create udev monitor for backlight monitoring";
+        return;
+    }
+
+    if (udev_monitor_filter_add_match_subsystem_devtype(m_backlightMonitor, "backlight", nullptr) < 0 ||
+        udev_monitor_enable_receiving(m_backlightMonitor) < 0) {
+        qWarning() << "[SysBackend] Failed to enable udev monitor for backlight monitoring";
+        udev_monitor_unref(m_backlightMonitor);
+        m_backlightMonitor = nullptr;
+        return;
+    }
+
+    const int monitorFd = udev_monitor_get_fd(m_backlightMonitor);
+    if (monitorFd < 0) {
+        qWarning() << "[SysBackend] Failed to get udev monitor fd for backlight monitoring";
+        udev_monitor_unref(m_backlightMonitor);
+        m_backlightMonitor = nullptr;
+        return;
+    }
+
+    m_backlightNotifier = new QSocketNotifier(monitorFd, QSocketNotifier::Read, this);
+    connect(m_backlightNotifier, &QSocketNotifier::activated, this, &SysBackend::handleBacklightMonitorEvent);
+}
+
+void SysBackend::handleBacklightMonitorEvent() {
+    if (!m_backlightMonitor) return;
+
+    bool shouldRefresh = false;
+    udev_device *device = nullptr;
+    while ((device = udev_monitor_receive_device(m_backlightMonitor)) != nullptr) {
+        shouldRefresh = true;
+        udev_device_unref(device);
+    }
+
+    if (shouldRefresh) updateBrightness();
+}
