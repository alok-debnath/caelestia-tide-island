+
+// Covers the Caelestia scheme bridge added on top of upstream Tide: fallback to
+// the stock palette, role mapping, live reload, and the kill switch.
+class StyleTokensBackendTests : public QObject {
+    Q_OBJECT
+
+private Q_SLOTS:
+    void init();
+    void cleanup();
+
+    void fallsBackToStockPaletteWithoutScheme();
+    void mapsSchemeRolesOntoTokens();
+    void keepsStockValueForRolesMissingFromScheme();
+    void appliesFixedAlphaToOverlayTokens();
+    void reloadsWhenSchemeChanges();
+    void envKillSwitchDisablesBridge();
+
+private:
+    void writeScheme(const QString &mode, const QString &colourPairs);
+
+    QTemporaryDir m_dir;
+    QString m_schemePath;
+};
+
+void StyleTokensBackendTests::init()
+{
+    QVERIFY(m_dir.isValid());
+    m_schemePath = m_dir.filePath(QStringLiteral("scheme.json"));
+    qputenv("TIDE_ISLAND_SCHEME_PATH", m_schemePath.toLocal8Bit());
+    qunsetenv("TIDE_ISLAND_CAELESTIA_THEME");
+}
+
+void StyleTokensBackendTests::cleanup()
+{
+    QFile::remove(m_schemePath);
+    qunsetenv("TIDE_ISLAND_SCHEME_PATH");
+    qunsetenv("TIDE_ISLAND_CAELESTIA_THEME");
+}
+
+void StyleTokensBackendTests::writeScheme(const QString &mode, const QString &colourPairs)
+{
+    QFile file(m_schemePath);
+    QVERIFY(file.open(QIODevice::WriteOnly | QIODevice::Truncate));
+    const QString json = QStringLiteral("{\"mode\": \"%1\", \"colours\": {%2}}").arg(mode, colourPairs);
+    QVERIFY(file.write(json.toUtf8()) > 0);
+    file.close();
+}
+
+void StyleTokensBackendTests::fallsBackToStockPaletteWithoutScheme()
+{
+    StyleTokensBackend tokens;
+
+    QVERIFY(!tokens.schemeActive());
+    QVERIFY(tokens.schemeMode().isEmpty());
+    QCOMPARE(tokens.module(), QColor(QStringLiteral("#1c1c1e")));
+    QCOMPARE(tokens.accent(), QColor(QStringLiteral("#0a84ff")));
+}
+
+void StyleTokensBackendTests::mapsSchemeRolesOntoTokens()
+{
+    // Caelestia writes colours as bare RRGGBB, without a leading '#'.
+    writeScheme(QStringLiteral("dark"),
+                QStringLiteral("\"surfaceContainer\": \"151a1e\", \"primary\": \"a7cbe7\", "
+                               "\"onSurface\": \"dfe6ee\", \"outline\": \"6f767d\""));
+
+    StyleTokensBackend tokens;
+
+    QVERIFY(tokens.schemeActive());
+    QCOMPARE(tokens.schemeMode(), QStringLiteral("dark"));
+    QCOMPARE(tokens.module(), QColor(QStringLiteral("#151a1e")));
+    QCOMPARE(tokens.accent(), QColor(QStringLiteral("#a7cbe7")));
+    QCOMPARE(tokens.textPrimary(), QColor(QStringLiteral("#dfe6ee")));
+    QCOMPARE(tokens.textTertiary(), QColor(QStringLiteral("#6f767d")));
+}
+
+void StyleTokensBackendTests::keepsStockValueForRolesMissingFromScheme()
+{
+    writeScheme(QStringLiteral("dark"), QStringLiteral("\"primary\": \"a7cbe7\""));
+
+    StyleTokensBackend tokens;
+
+    QCOMPARE(tokens.accent(), QColor(QStringLiteral("#a7cbe7")));
+    // No surfaceContainer role in this scheme, so the stock value stands.
+    QCOMPARE(tokens.module(), QColor(QStringLiteral("#1c1c1e")));
+}
+
+void StyleTokensBackendTests::appliesFixedAlphaToOverlayTokens()
+{
+    writeScheme(QStringLiteral("dark"),
+                QStringLiteral("\"primary\": \"a7cbe7\", \"surfaceContainerLowest\": \"000000\""));
+
+    StyleTokensBackend tokens;
+
+    const QColor borderHover = tokens.workspaceCellBorderHover();
+    QCOMPARE(borderHover.alpha(), 0x66);
+    QCOMPARE(borderHover.rgb(), QColor(QStringLiteral("#a7cbe7")).rgb());
+
+    QCOMPARE(tokens.workspaceOverlay().alpha(), 0x42);
+    // Opaque tokens must stay opaque.
+    QCOMPARE(tokens.workspaceCell().alpha(), 0xff);
+}
+
+void StyleTokensBackendTests::reloadsWhenSchemeChanges()
+{
+    writeScheme(QStringLiteral("dark"), QStringLiteral("\"primary\": \"a7cbe7\""));
+
+    StyleTokensBackend tokens;
+    QCOMPARE(tokens.accent(), QColor(QStringLiteral("#a7cbe7")));
+
+    QSignalSpy spy(&tokens, &StyleTokensBackend::schemeChanged);
+    writeScheme(QStringLiteral("light"), QStringLiteral("\"primary\": \"40637b\""));
+
+    QVERIFY(spy.wait(4000));
+    QCOMPARE(tokens.accent(), QColor(QStringLiteral("#40637b")));
+    QCOMPARE(tokens.schemeMode(), QStringLiteral("light"));
+}
+
+void StyleTokensBackendTests::envKillSwitchDisablesBridge()
+{
+    writeScheme(QStringLiteral("dark"), QStringLiteral("\"primary\": \"a7cbe7\""));
+    qputenv("TIDE_ISLAND_CAELESTIA_THEME", "0");
+
+    StyleTokensBackend tokens;
+
+    QVERIFY(!tokens.schemeActive());
+    QCOMPARE(tokens.accent(), QColor(QStringLiteral("#0a84ff")));
+}
