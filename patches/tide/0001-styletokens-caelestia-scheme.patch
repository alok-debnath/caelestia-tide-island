+QString StyleTokensBackend::schemePath()
+{
+    const QByteArray override = qgetenv("TIDE_ISLAND_SCHEME_PATH");
+    if (!override.isEmpty())
+        return QString::fromLocal8Bit(override);
+
+    QString state = QString::fromLocal8Bit(qgetenv("XDG_STATE_HOME"));
+    if (state.isEmpty())
+        state = QDir::homePath() + QStringLiteral("/.local/state");
+
+    return state + QStringLiteral("/caelestia/scheme.json");
+}
+
 StyleTokensBackend::StyleTokensBackend(QObject *parent)
     : QObject(parent)
+    , m_path(schemePath())
+    , m_enabled(!envDisabled())
+{
+    if (!m_enabled)
+        return;
+
+    m_debounce = new QTimer(this);
+    m_debounce->setSingleShot(true);
+    m_debounce->setInterval(kReloadDebounceMs);
+    connect(m_debounce, &QTimer::timeout, this, [this] {
+        reload();
+        watchScheme();
+    });
+
+    m_watcher = new QFileSystemWatcher(this);
+    connect(m_watcher, &QFileSystemWatcher::fileChanged, m_debounce, qOverload<>(&QTimer::start));
+    connect(m_watcher, &QFileSystemWatcher::directoryChanged, m_debounce, qOverload<>(&QTimer::start));
+
+    reload();
+    watchScheme();
+}
+
+void StyleTokensBackend::reload()
+{
+    QHash<QString, QColor> colours;
+    QString mode;
+
+    QFile file(m_path);
+    if (file.open(QIODevice::ReadOnly)) {
+        const QJsonDocument doc = QJsonDocument::fromJson(file.readAll());
+        const QJsonObject root = doc.object();
+        mode = root.value(QStringLiteral("mode")).toString();
+
+        const QJsonObject palette = root.value(QStringLiteral("colours")).toObject();
+        for (auto it = palette.constBegin(); it != palette.constEnd(); ++it) {
+            const QColor colour = schemeColour(it.value().toString());
+            if (colour.isValid())
+                colours.insert(it.key(), colour);
+        }
+    }
+
+    if (colours == m_colours && mode == m_mode)
+        return;
+
+    m_colours = colours;
+    m_mode = mode;
+    Q_EMIT schemeChanged();
+}
+
+void StyleTokensBackend::watchScheme()
+{
+    if (!m_watcher)
+        return;
+
+    const QStringList watched = m_watcher->files() + m_watcher->directories();
+    if (!watched.isEmpty())
+        m_watcher->removePaths(watched);
+
+    // Watch the directory too: an atomic replace creates a new inode, and the
+    // file watch alone would go stale after the first wallpaper change.
+    const QString dir = QFileInfo(m_path).absolutePath();
+    if (QFileInfo::exists(dir))
+        m_watcher->addPath(dir);
+    if (QFileInfo::exists(m_path))
+        m_watcher->addPath(m_path);
+}
+
+QColor StyleTokensBackend::token(const char *role, const char *fallbackHex, int alpha) const
+{
+    QColor colour;
+
+    if (m_enabled && role) {
+        const auto it = m_colours.constFind(QString::fromLatin1(role));
+        if (it != m_colours.constEnd())
+            colour = it.value();
+    }
+
+    if (!colour.isValid())
+        colour = hex(fallbackHex);
+
+    if (alpha >= 0)
+        colour.setAlpha(alpha);
+
+    return colour;
+}
+
+bool StyleTokensBackend::schemeActive() const
 {
+    return m_enabled && !m_colours.isEmpty();
+}
+
+QString StyleTokensBackend::schemeMode() const
+{
+    return schemeActive() ? m_mode : QString();
 }
 
