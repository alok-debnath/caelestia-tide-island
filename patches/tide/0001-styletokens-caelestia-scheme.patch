+// Caelestia stores colours as bare RRGGBB (no leading '#', no alpha).
+QColor schemeColour(const QString &value)
+{
+    if (value.isEmpty())
+        return QColor();
+
+    const QString normalised = value.startsWith(QLatin1Char('#')) ? value : QLatin1Char('#') + value;
+    const QColor colour(normalised);
+    return colour.isValid() ? colour : QColor();
 }
 
